DATABASE_URL=postgres://statzavod:statzavod@postgres:5432/statzavod?sslmode=disable
APP_ENV=development
HTTP_ADDR=:8080
SESSION_COOKIE_NAME=statzavod_session
BOOTSTRAP_EMAIL=admin@example.com
BOOTSTRAP_PASSWORD=change-me-before-production
CORS_ORIGIN=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:5173
# 32-byte base64url key. Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
SMTP_URL=
# Set all three values for each enabled platform; never commit real secrets.
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REDIRECT_URL=http://localhost:8080/api/v1/oauth/youtube/callback
# Optional test/self-hosted endpoint overrides:
# YOUTUBE_OAUTH_BASE=https://oauth2.googleapis.com
# YOUTUBE_API_BASE=https://www.googleapis.com/youtube/v3
# YOUTUBE_ANALYTICS_BASE=https://youtubeanalytics.googleapis.com/v2
INSTAGRAM_OAUTH_CLIENT_ID=
INSTAGRAM_OAUTH_CLIENT_SECRET=
INSTAGRAM_OAUTH_REDIRECT_URL=http://localhost:8080/api/v1/oauth/instagram/callback
INSTAGRAM_FACEBOOK_OAUTH_CLIENT_ID=
INSTAGRAM_FACEBOOK_OAUTH_CLIENT_SECRET=
INSTAGRAM_FACEBOOK_OAUTH_REDIRECT_URL=http://localhost:8080/api/v1/oauth/instagram-facebook/callback
# Required for the "Instagram via Facebook" flow. Create a Facebook Login for Business
# configuration in Meta and paste its Config ID here.
INSTAGRAM_FACEBOOK_CONFIG_ID=
# INSTAGRAM_OAUTH_BASE=https://www.instagram.com
# INSTAGRAM_TOKEN_BASE=https://api.instagram.com
# INSTAGRAM_API_BASE=https://graph.instagram.com
# INSTAGRAM_FACEBOOK_OAUTH_BASE=https://www.facebook.com
# INSTAGRAM_FACEBOOK_GRAPH_API_BASE=https://graph.facebook.com
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URL=http://localhost:8080/api/v1/oauth/tiktok/callback
VK_OAUTH_CLIENT_ID=
VK_OAUTH_CLIENT_SECRET=
VK_OAUTH_REDIRECT_URL=http://localhost:8080/api/v1/oauth/vk/callback
# VK_OAUTH_BASE=https://oauth.vk.com
# VK_API_BASE=https://api.vk.ru
# VK_API_VERSION=5.199
