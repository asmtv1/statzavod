{$SITE_ADDRESS:localhost} {
  encode zstd gzip
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "strict-origin-when-cross-origin"
    Content-Security-Policy "default-src 'self'; connect-src 'self' https://open.tiktokapis.com; img-src 'self' https: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
  }
  route {
    handle /api/* {
      reverse_proxy api:8080
    }
    handle /healthz {
      reverse_proxy api:8080
    }
    handle /readyz {
      reverse_proxy api:8080
    }
    handle {
      root * /usr/share/caddy
      try_files {path} /index.html
      file_server
    }
  }
}
