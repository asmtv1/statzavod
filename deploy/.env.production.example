# Reference for the values generated by GitHub Actions.
# Do not copy this file to the server and never commit real values.

POSTGRES_DB=statzavod
POSTGRES_USER=statzavod
POSTGRES_PASSWORD=replace-with-a-long-random-password
# Generated automatically from the three values above by GitHub Actions.
POSTGRES_DB_URLENCODED=statzavod
POSTGRES_USER_URLENCODED=statzavod
POSTGRES_PASSWORD_URLENCODED=replace-with-a-long-random-password

PUBLIC_BASE_URL=https://statzavod.ru
CORS_ORIGIN=https://statzavod.ru
SITE_ADDRESS=statzavod.ru, www.statzavod.ru
MEDIA_SITE_ADDRESS=media.statzavod.ru

BOOTSTRAP_EMAIL=admin@example.com
BOOTSTRAP_PASSWORD=replace-with-a-long-random-password
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=replace-with-a-32-byte-base64-key
SMTP_URL=

YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REDIRECT_URL=https://statzavod.ru/api/v1/oauth/youtube/callback

INSTAGRAM_OAUTH_CLIENT_ID=
INSTAGRAM_OAUTH_CLIENT_SECRET=
INSTAGRAM_OAUTH_REDIRECT_URL=https://statzavod.ru/api/v1/oauth/instagram/callback
INSTAGRAM_FACEBOOK_OAUTH_CLIENT_ID=
INSTAGRAM_FACEBOOK_OAUTH_CLIENT_SECRET=
INSTAGRAM_FACEBOOK_OAUTH_REDIRECT_URL=https://statzavod.ru/api/v1/oauth/instagram-facebook/callback
INSTAGRAM_FACEBOOK_CONFIG_ID=

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URL=https://statzavod.ru/api/v1/oauth/tiktok/callback

VK_OAUTH_CLIENT_ID=
VK_OAUTH_CLIENT_SECRET=
VK_OAUTH_REDIRECT_URL=https://statzavod.ru/api/v1/oauth/vk/callback

# Keep global publishing off until the internal test company and provider review
# have passed. All provider flags are independently reversible.
CONTENT_PUBLISHING_ENABLED=false
CONTENT_TIKTOK_ENABLED=false
CONTENT_INSTAGRAM_ENABLED=false
CONTENT_YOUTUBE_ENABLED=false
CONTENT_VK_ENABLED=false

# Local Prometheus TSDB retention. Prometheus has no published host port;
# scrape and alert evaluation stay inside the production Compose network.
PROMETHEUS_RETENTION_TIME=15d

# Private Yandex Object Storage bucket and the HTTPS provider-safe delivery host.
MEDIA_S3_ENDPOINT=https://storage.yandexcloud.net
# Exact browser-visible HTTPS origin used by multipart PUT requests. It must
# equal MEDIA_S3_ENDPOINT after removing one trailing slash; no wildcard/path.
MEDIA_UPLOAD_ORIGIN=https://storage.yandexcloud.net
MEDIA_S3_REGION=ru-central1
MEDIA_S3_BUCKET=
MEDIA_S3_ACCESS_KEY=
MEDIA_S3_SECRET_KEY=
MEDIA_PUBLIC_BASE_URL=https://media.statzavod.ru
# Exactly 32 random bytes encoded as base64; keep independent from S3 keys.
# Generate once with: openssl rand -base64 32
MEDIA_DELIVERY_TOKEN_KEY=
YOUTUBE_UPLOAD_BASE=https://www.googleapis.com/upload/youtube/v3
