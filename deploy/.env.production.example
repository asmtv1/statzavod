# Copy this file to <DEPLOY_PATH>/shared/.env on the server.
# Keep permissions at 600 and never commit the real values.

POSTGRES_DB=statzavod
POSTGRES_USER=statzavod
POSTGRES_PASSWORD=replace-with-a-long-random-password

PUBLIC_BASE_URL=https://statzavod.ru
CORS_ORIGIN=https://statzavod.ru
SITE_ADDRESS=statzavod.ru, www.statzavod.ru

BOOTSTRAP_EMAIL=admin@example.com
BOOTSTRAP_PASSWORD=replace-with-a-long-random-password
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=replace-with-a-32-byte-base64-key
SMTP_URL=

YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REDIRECT_URL=https://statzavod.ru/api/v1/oauth/youtube/callback

INSTAGRAM_OAUTH_CLIENT_ID=
INSTAGRAM_OAUTH_CLIENT_SECRET=
INSTAGRAM_OAUTH_REDIRECT_URL=https://statzavod.ru/api/v1/oauth/instagram/callback

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URL=https://statzavod.ru/api/v1/oauth/tiktok/callback

VK_OAUTH_CLIENT_ID=
VK_OAUTH_CLIENT_SECRET=
VK_OAUTH_REDIRECT_URL=https://statzavod.ru/api/v1/oauth/vk/callback
